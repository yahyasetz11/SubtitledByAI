# WAJIB — transkripsi + translasi default
GEMINI_API_KEY=
# opsional
OPENAI_API_KEY=
# opsional
ANTHROPIC_API_KEY=

TRANSCRIBE_MODEL=gemini-2.5-pro
TRANSLATE_MODEL_GEMINI=gemini-2.5-flash
TRANSLATE_MODEL_OPENAI=gpt-4o
TRANSLATE_MODEL_ANTHROPIC=claude-sonnet-4-6

# opsional, untuk video region-locked/membership
YTDLP_COOKIES_FILE=

SUB_MIN_DURATION=0.7
SUB_MAX_DURATION=7.5
SUB_MERGE_GAP=0.5
SUB_CPS_FLAG=25

# Chunk size for audio splitting (minutes). Smaller = better timestamp accuracy per chunk.
# Increase to reduce API calls (more cost-efficient). Previous default was 10–14 min.
CHUNK_MIN_MINUTES=4
CHUNK_MAX_MINUTES=6
